ENVIRONMENT=development
MYSQL_DATABASE=lanternfall
MYSQL_USER=lanternfall
MYSQL_PORT=33306
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
DATABASE_URL=mysql+pymysql://lanternfall:replace-with-a-local-password@127.0.0.1:33306/lanternfall?charset=utf8mb4
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Local preview only. Production startup refuses this option.
ALLOW_DEV_LOGIN=false
SESSION_TTL_SECONDS=604800
# Development default: true. In production use Alembic, not automatic DDL.
DB_AUTO_CREATE=false
